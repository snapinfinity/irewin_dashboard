rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Any of the three roles (owner/admin/employee) — replaces the old
    // isAdmin() name now that "admin" is one specific tier, not "any staff".
    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // Super Admin or Admin — full content CRUD (including delete). Whether
    // an Admin may remove another Admin (Super Admin only) is enforced in
    // the /api/admin/remove-admin route, not here — every write to the
    // admins collection goes through the Admin SDK regardless of role (see
    // below), so there's no per-role Firestore rule to express for that.
    function isAdminOrAbove() {
      return isStaff() && (role() == 'owner' || role() == 'admin');
    }

    // Soft delete ("trash") sets isDeleted instead of removing the document.
    // Since that happens through `update`, an Employee's existing "may edit
    // my own doc" allowance would otherwise let them soft-delete/restore
    // their own docs too — this guard keeps that Admin-or-above-only, same
    // as hard delete always was. get(field, default) is required (not bare
    // field access) since most existing docs predate this field entirely.
    function isDeletedUnchanged() {
      return request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false);
    }

    // --- admins ---
    match /admins/{uid} {
      // A user may only read THEIR OWN admin doc (to check their own status).
      // No listing, no reading others' docs -> collection is never publicly enumerable.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      // No client writes at all, any role included. Admin/Employee docs are
      // only ever created/removed via the Admin SDK — the seed script
      // (initial Super Admin bootstrap) or the /api/admin/add-admin and
      // /api/admin/remove-admin routes (which independently re-verify the
      // caller's role server-side before touching this collection).
      allow write: if false;
    }

    // The anonymous read grants below are NOT for this app — this project is
    // the admin dashboard and every one of its pages requires a signed-in
    // staff member. They exist so the separate public IREWIN job site (its
    // own project) can read listings without authenticating.
    //
    // Write model, identical across jobs/categories/companies:
    //   create — any staff member, and only as themselves (createdBy must be
    //            their own uid, so nobody can create a doc "owned" by someone
    //            else).
    //   update — Admin or above can edit anything; an Employee can only edit
    //            a doc they created (and can't reassign createdBy to dodge
    //            that check).
    //   delete — Admin or above only. An Employee can never delete, even
    //            their own doc — enforced here, not just by hiding the
    //            button client-side.

    // --- jobs ---
    match /jobs/{jobId} {
      // Public site sees published, non-trashed jobs only; drafts/
      // unpublished/expired/soft-deleted are visible to staff alone.
      allow get, list: if (resource.data.status == 'published' &&
        resource.data.get('isDeleted', false) == false) || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdminOrAbove() ||
        (isStaff() &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          isDeletedUnchanged());
      allow delete: if isAdminOrAbove();
    }

    // --- categories ---
    match /categories/{categoryId} {
      // Public site's category listing + filters. Soft-deleted categories
      // are excluded for the public (even though that site is a separate
      // codebase we don't control the read side of), but staff must still
      // be able to read them — otherwise the admin dashboard's own Trash
      // page couldn't list or restore a soft-deleted category.
      // TODO when the public site ships: consider also restricting to
      // `resource.data.enabled == true` so disabled categories can't leak.
      allow get, list: if resource.data.get('isDeleted', false) == false || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdminOrAbove() ||
        (isStaff() &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          isDeletedUnchanged());
      allow delete: if isAdminOrAbove();
    }

    // --- companies ---
    match /companies/{companyId} {
      // Public site renders company name/logo on job listings. Soft-deleted
      // companies are excluded for the public, but staff must still be able
      // to read them for the Trash page — same reasoning as categories above.
      allow get, list: if resource.data.get('isDeleted', false) == false || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdminOrAbove() ||
        (isStaff() &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          isDeletedUnchanged());
      allow delete: if isAdminOrAbove();
    }

    // --- users (public site accounts, Google sign-in) ---
    // One doc per signed-in visitor of the public IREWIN site, id = their
    // Firebase Auth uid. Holds their profile, email-marketing consent and
    // Premium membership. Staff can read all of them (e.g. to export the
    // opted-in mailing list); nobody can list other users' docs otherwise.
    match /users/{uid} {
      function isSelf() {
        return isSignedIn() && request.auth.uid == uid;
      }
      allow get: if isSelf() || isStaff();
      allow list: if isStaff();
      // Created by the site on first sign-in, only for yourself, with your own email
      // and without Premium.
      allow create: if isSelf() &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.get('membership', null) == null;
      // You can update your own doc but never change who it belongs to, when it was
      // created, or your Premium membership. Membership is only written by the public
      // site's server (Firebase Admin, after a confirmed Dodo payment) or by admins.
      allow update: if (isSelf() &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('membership', null) == resource.data.get('membership', null)) || isAdminOrAbove();
      allow delete: if isAdminOrAbove();
    }

    // --- reviews (customer reviews on the public IREWIN site) ---
    // One review per signed-in visitor, id = their uid. Written by the public
    // site as "pending"; staff approve or reject it in the dashboard, and only
    // approved reviews are publicly readable (the site queries status ==
    // 'approved'). Editing your review sends it back to "pending".
    match /reviews/{uid} {
      function isAuthor() {
        return isSignedIn() && request.auth.uid == uid;
      }
      // The author always writes the whole doc (setDoc), as pending, with a
      // fresh updatedAt. Moderation fields are only ever set by staff.
      function isValidAuthorWrite() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'photoURL', 'rating', 'text', 'status', 'createdAt', 'updatedAt']) &&
          d.keys().hasAll(['uid', 'name', 'photoURL', 'rating', 'text', 'status', 'createdAt', 'updatedAt']) &&
          d.uid == uid &&
          d.status == 'pending' &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
          (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 500)) &&
          d.rating is int && d.rating >= 1 && d.rating <= 5 &&
          d.text is string && d.text.size() >= 10 && d.text.size() <= 600 &&
          d.updatedAt == request.time;
      }
      allow get: if resource.data.status == 'approved' || isAuthor() || isStaff();
      allow list: if resource.data.status == 'approved' || isStaff();
      allow create: if isAuthor() && isValidAuthorWrite() && request.resource.data.createdAt == request.time;
      allow update: if (isAuthor() && isValidAuthorWrite() && request.resource.data.createdAt == resource.data.createdAt) ||
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
          request.resource.data.status in ['pending', 'approved', 'rejected'] &&
          request.resource.data.reviewedBy == request.auth.uid);
      allow delete: if isAuthor() || isAdminOrAbove();
    }

    // --- jobLocationStats ---
    // Internal aggregate for the admin dashboard's Location chart, kept in
    // sync transactionally by createJob/updateJob/deleteJob/restoreJob. No
    // public access needed — only the admin dashboard reads it. Any staff
    // member needs write access here since any staff member can create/edit/
    // delete their own jobs (same trust level jobs/categories/companies
    // already extend to staff).
    match /jobLocationStats/{locationSlug} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
